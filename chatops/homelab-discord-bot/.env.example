# =============================================================================
# Homelab Discord Bot Environment Configuration
# =============================================================================

# Token do Bot no Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# IDs dos usuários autorizados a executar comandos de controle (separados por vírgula)
AUTHORIZED_USER_IDS=123456789012345678

# ID do canal onde alertas proativos serão enviados
ALERT_CHANNEL_ID=123456789012345678

# Limiares de Alerta do Host (%)
DISK_ALERT=90
CPU_ALERT=90
RAM_ALERT=90
TEMP_ALERT=80

# Intervalos de Verificação (segundos e minutos)
MONITOR_INTERVAL=5
ALERT_COOLDOWN=60
COMMAND_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=homelab_bot.log
MAX_LOG_SIZE=5242880
LOG_BACKUP_COUNT=3

# Histórico
ALERT_HISTORY_FILE=alert_history.json
MAX_ALERTS_HISTORY=100
