# =============================================================================
# Antigravity Telegram Bot Environment Configuration
# =============================================================================

# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=0000000000:AAExampleTelegramBotTokenHere

# Chat IDs numéricos autorizados (separados por vírgula)
ALLOWED_CHAT_IDS=123456789

# Caminho para o binário da CLI
AGY_PATH=/usr/local/bin/agy

# Diretório padrão de trabalho para execução de comandos pelo agente
DEFAULT_WORKSPACE=/home/tiago2609

# Modelo de IA padrão e esforço de raciocínio
DEFAULT_MODEL=gemini-3.8-flash-high
DEFAULT_EFFORT=high

# Timeout de tarefas assíncronas em segundos
TIMEOUT_SECONDS=600
