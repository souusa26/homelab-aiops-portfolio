# =============================================================================
# Telas Livres — Digital Signage (DOOH) Environment Configuration
# =============================================================================

BIND_ADDR=127.0.0.1
DOMAIN_NAME=app.example.com

# Banco de Dados PostgreSQL (Produção)
POSTGRES_USER=telas_admin
POSTGRES_PASSWORD=change_me_super_secret_db_pass
POSTGRES_DB=telas_livres_prod

# Banco de Dados PostgreSQL (Homologação)
POSTGRES_USER_HOMOLOG=telas_homolog
POSTGRES_PASSWORD_HOMOLOG=change_me_homolog_pass
POSTGRES_DB_HOMOLOG=telas_livres_homolog

# Armazenamento e Ingestão de Vídeos
UPLOAD_DIR=videos

# Autenticação JWT e RBAC
SECRET_KEY=change_me_to_a_random_32_bytes_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — Origens autorizadas
CORS_ORIGINS=https://app.example.com,https://admin.example.com,https://tablet.example.com

# Cloudflare Named Tunnel Token (Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiZXhhbXBsZVRva2VuSGVyZ...
CLOUDFLARE_TUNNEL_TOKEN_HOMOLOG=eyJhIjoiZXhhbXBsZVRva2VuSG9tb2xvZ...
