# =============================================================================
# Media Stack Environment Configuration
# =============================================================================

PUID=1000
PGID=1000
TZ=America/Sao_Paulo
BIND_ADDR=127.0.0.1

MEDIA_CONFIG_DIR=./config
MEDIA_DATA_DIR=./data

# Caminhos locais para montagens remotas gerenciadas pelo systemd e script watchdog
REMOTE_FILMES_PATH=/mnt/remote_filmes
REMOTE_SERIES_PATH=/mnt/remote_series

# Portas dos serviços
QBITTORRENT_PORT=8080
