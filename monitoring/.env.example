# =============================================================================
# Variáveis de Ambiente — Stack de Observabilidade (Prometheus + Grafana + Exporters)
# =============================================================================

# Bind address para expor portas de administração (127.0.0.1 para acesso apenas local ou via VPN Mesh)
BIND_ADDR=127.0.0.1
GRAFANA_PORT=3000

# Credenciais de Administrador do Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_super_secret_password

# Retenção do banco de séries temporais Prometheus (TSDB)
PROMETHEUS_RETENTION=15d

# Integração de Alertas do Grafana com Telegram (Contact Points)
TELEGRAM_BOT_TOKEN=0000000000:AAExampleTelegramBotTokenHere
TELEGRAM_CHAT_ID=123456789

# Domínio público ou sintético monitorado via Blackbox Exporter
PUBLIC_APP_DOMAIN=https://app.example.com

# Plex Media Server Exporter
PLEX_URL=http://host.docker.internal:32400
PLEX_TOKEN=your_plex_token_here

# qBittorrent Exporter
QBITTORRENT_BASE_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=your_qbittorrent_password
